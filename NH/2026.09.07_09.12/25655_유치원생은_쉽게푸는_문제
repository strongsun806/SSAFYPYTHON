# 예?? 뭐라는거야

T = int(input())
for tc in range(1, T+1):
    X = int(input())

    # 1 인경우에는 그냥 바로 0
    if X == 1:
        N = [0]
    # X 가 0인경우엔.. 나누기가 안되니까 한번..더?
    elif X == 0:
        N = [1]

    elif X%2 == 0:
        # 움.. N은 무조건 8이여야하고.. N//2번 한만큼 들어가고..?
        N = [8] * (X//2)

    elif X%2 == 1:
        # 만약 X가 홀수라면?(1,3,5..) shit~~ 지능 3상승!!! 4를 먼저 넣고 나머지 짝수갯수만큼 다 8넣으면 끝아니묘!!!
        N = [4] + [8]* ((X-1)//2)

    # 여기서부턴 검색을 쫌 했서요. 왜냐면 print(N)하니까 리스트로 나오는데,, 해결방법을 몰라서
    result = "".join(map(str, N))
    print(result)